    <Color x:Key="DangerBgDark">#450A0A</Color>
    <Color x:Key="DangerBorderDark">#991B1B</Color>

    <Color x:Key="InfoFg">#1E40AF</Color>
    <Color x:Key="InfoBg">#DBEAFE</Color>
    <Color x:Key="InfoBorder">#BFDBFE</Color>
    <Color x:Key="InfoAccent">#2563EB</Color>
    <Color x:Key="InfoFgDark">#93C5FD</Color>
    <Color x:Key="InfoBgDark">#172554</Color>
    <Color x:Key="InfoBorderDark">#1D4ED8</Color>

    <Color x:Key="CheckedInFg">#155E75</Color>
    <Color x:Key="CheckedInBg">#CFFAFE</Color>
    <Color x:Key="CheckedInBorder">#A5F3FC</Color>
    <Color x:Key="CheckedInFgDark">#67E8F9</Color>
    <Color x:Key="CheckedInBgDark">#083344</Color>
    <Color x:Key="CheckedInBorderDark">#155E75</Color>

    <Color x:Key="InProgressFg">#1D4ED8</Color>
    <Color x:Key="InProgressBg">#EFF6FF</Color>
    <Color x:Key="InProgressBorder">#93C5FD</Color>
    <Color x:Key="InProgressFgDark">#93C5FD</Color>
    <Color x:Key="InProgressBgDark">#1E3A8A</Color>
    <Color x:Key="InProgressBorderDark">#3B82F6</Color>

    <!-- 4-Tier Loyalty Progression Metallics -->
    <Color x:Key="TierBronzeFg">#78350F</Color>
    <Color x:Key="TierBronzeBg">#FEF3C7</Color>
    <Color x:Key="TierBronzeBorder">#F59E0B</Color>
    <Color x:Key="TierBronzeAccent">#B45309</Color>

    <Color x:Key="TierSilverFg">#1E293B</Color>
    <Color x:Key="TierSilverBg">#E2E8F0</Color>
    <Color x:Key="TierSilverBorder">#94A3B8</Color>
    <Color x:Key="TierSilverAccent">#64748B</Color>

    <Color x:Key="TierGoldFg">#713F12</Color>
    <Color x:Key="TierGoldBg">#FEF9C3</Color>
    <Color x:Key="TierGoldBorder">#EAB308</Color>
    <Color x:Key="TierGoldAccent">#CA8A04</Color>

    <Color x:Key="TierPlatinumFg">#0F172A</Color>
    <Color x:Key="TierPlatinumBg">#E2E8F0</Color>
    <Color x:Key="TierPlatinumBorder">#38BDF8</Color>
    <Color x:Key="TierPlatinumAccent">#0284C7</Color>

    <!-- Focus Ring & Shimmer -->
    <Color x:Key="FocusRing">#2563EB</Color>
    <Color x:Key="ShimmerBaseLight">#E2E8F0</Color>
    <Color x:Key="ShimmerBaseDark">#1E293B</Color>

</ResourceDictionary>
