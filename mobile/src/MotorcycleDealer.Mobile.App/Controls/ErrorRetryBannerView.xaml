<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MotorcycleDealer.Mobile.App.Controls.ErrorRetryBannerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:MotorcycleDealer.Mobile.App.Icons"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:Name="Root"
    x:DataType="controls:ErrorRetryBannerView">

    <Border
        Style="{StaticResource AlertDangerBanner}"
        IsVisible="{Binding Source={x:Reference Root}, Path=HasMessage}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Label
                Text="{x:Static icons:PhosphorIcons.WarningCircle}"
                FontFamily="PhosphorFill"
                FontSize="20"
                LineHeight="1"
                TextColor="{AppThemeBinding Light={StaticResource DangerAccent}, Dark={StaticResource DangerAccentDark}}"
                VerticalOptions="Center" />

            <Label
                Grid.Column="1"
                Text="{Binding Source={x:Reference Root}, Path=Message}"
                FontFamily="BeVietnamProMedium"
                FontSize="13"
                TextColor="{AppThemeBinding Light={StaticResource DangerFg}, Dark={StaticResource DangerFgDark}}"
                VerticalTextAlignment="Center" />

            <Button
                Grid.Column="2"
                Text="{Binding Source={x:Reference Root}, Path=EffectiveRetryText}"
                Command="{Binding Source={x:Reference Root}, Path=RetryCommand}"
                IsVisible="{Binding Source={x:Reference Root}, Path=ShowRetry}"
                Style="{StaticResource DangerOutlineButton}"
                HeightRequest="44"
                MinimumHeightRequest="44"
                Padding="12,0"
                FontSize="12"
                VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
