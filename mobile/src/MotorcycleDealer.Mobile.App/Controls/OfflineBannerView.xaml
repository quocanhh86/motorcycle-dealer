<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MotorcycleDealer.Mobile.App.Controls.OfflineBannerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:MotorcycleDealer.Mobile.App.Icons"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:Name="Root"
    x:DataType="controls:OfflineBannerView">

    <Border
        x:Name="BannerCard"
        Style="{StaticResource AlertWarningBanner}"
        IsVisible="False">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Label
                Text="{x:Static icons:PhosphorIcons.WifiSlash}"
                FontFamily="Phosphor"
                FontSize="18"
                LineHeight="1"
                TextColor="{AppThemeBinding Light={StaticResource WarningAccent}, Dark={StaticResource WarningAccentDark}}"
                VerticalOptions="Center" />

            <Label
                Grid.Column="1"
                Text="{Binding Source={x:Reference Root}, Path=DisplayMessage}"
                FontFamily="BeVietnamProMedium"
                FontSize="12"
                TextColor="{AppThemeBinding Light={StaticResource WarningFg}, Dark={StaticResource WarningFgDark}}"
                VerticalTextAlignment="Center" />

            <Label
                Grid.Column="2"
                Text="{Binding Source={x:Reference Root}, Path=SyncCaption}"
                IsVisible="{Binding Source={x:Reference Root}, Path=HasSyncCaption}"
                FontFamily="JetBrainsMonoMedium"
                FontSize="11"
                TextColor="{AppThemeBinding Light={StaticResource WarningFg}, Dark={StaticResource WarningFgDark}}"
                VerticalTextAlignment="Center" />
        </Grid>
    </Border>
</ContentView>
