<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MotorcycleDealer.Mobile.App.Controls.StatusBadgeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:Name="Root"
    x:DataType="controls:StatusBadgeView">

    <Border
        BackgroundColor="{Binding Source={x:Reference Root}, Path=BadgeBackground}"
        Stroke="{Binding Source={x:Reference Root}, Path=BadgeBorder}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 6"
        Padding="8,4"
        VerticalOptions="Center"
        HorizontalOptions="Start">
        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
            <BoxView
                WidthRequest="7"
                HeightRequest="7"
                CornerRadius="4"
                Color="{Binding Source={x:Reference Root}, Path=BadgeForeground}"
                VerticalOptions="Center" />
            <Label
                Text="{Binding Source={x:Reference Root}, Path=DisplayText}"
                TextColor="{Binding Source={x:Reference Root}, Path=BadgeForeground}"
                FontSize="11"
                FontAttributes="Bold"
                VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
