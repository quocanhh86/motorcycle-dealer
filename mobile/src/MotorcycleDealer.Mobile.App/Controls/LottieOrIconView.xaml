<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MotorcycleDealer.Mobile.App.Controls.LottieOrIconView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:Name="Root"
    x:DataType="controls:LottieOrIconView">

    <Grid
        WidthRequest="{Binding Source={x:Reference Root}, Path=Size}"
        HeightRequest="{Binding Source={x:Reference Root}, Path=Size}"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <skia:SKLottieView
            x:Name="LottiePlayer"
            WidthRequest="{Binding Source={x:Reference Root}, Path=Size}"
            HeightRequest="{Binding Source={x:Reference Root}, Path=Size}"
            IsAnimationEnabled="False"
            IsVisible="False"
            RepeatMode="Restart"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            x:Name="FallbackIconLabel"
            Text="{Binding Source={x:Reference Root}, Path=FallbackGlyph}"
            TextColor="{Binding Source={x:Reference Root}, Path=FallbackColor}"
            FontFamily="Phosphor"
            FontSize="{Binding Source={x:Reference Root}, Path=IconFontSize}"
            LineHeight="1"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
