<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MotorcycleDealer.Mobile.App.Views.Staff.SlotCapacityPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MotorcycleDealer.Mobile.Core.ViewModels.Staff;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:dto="clr-namespace:MotorcycleDealer.Mobile.Core.Contracts;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:stf="clr-namespace:MotorcycleDealer.Mobile.App.Views.Staff"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:Name="PageRoot"
    x:DataType="vm:SlotCapacityViewModel"
    Title="Bay Capacity">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadSlotsCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Style="{StaticResource CarbonHeaderCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ROWVERSION SERVICE BAY CAPACITY" Style="{StaticResource EyebrowLabel}" />
                        <Label
                            Text="Workshop Time-Slot Planner"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Slate50}" />
                        <Label
                            Text="Generate rolling 7-day bay schedules, adjust capacity, or block bays for maintenance."
                            FontSize="12"
                            TextColor="{StaticResource Slate300}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AlertSuccessBanner}" IsVisible="{Binding HasSuccess}">
                    <Label
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SuccessFg}, Dark={StaticResource SuccessFgDark}}" />
                </Border>

                <Border Style="{StaticResource AlertDangerBanner}" IsVisible="{Binding HasError}">
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource DangerFg}, Dark={StaticResource DangerFgDark}}" />
                </Border>

                <!-- Rolling Generator Controls -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="BATCH BAY GENERATOR" Style="{StaticResource EyebrowLabel}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="From Date" Style="{StaticResource CaptionLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <DatePicker x:Name="FromDatePicker" DateSelected="OnFromDateSelected" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="To Date" Style="{StaticResource CaptionLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <DatePicker x:Name="ToDatePicker" DateSelected="OnToDateSelected" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Slot Duration (min)" Style="{StaticResource CaptionLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry Text="{Binding GenerateDurationMinutes}" Style="{StaticResource MonoEntry}" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Bays per Slot" Style="{StaticResource CaptionLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry Text="{Binding GenerateMaxCapacity}" Style="{StaticResource MonoEntry}" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button
                                Text="Load Slots"
                                Command="{Binding LoadSlotsCommand}"
                                Style="{StaticResource SecondaryButton}" />
                            <Button
                                Grid.Column="1"
                                Text="Generate Batch"
                                Command="{Binding GenerateRollingSlotsCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <controls:ShimmerCardView IsVisible="{Binding IsBusy}" CardHeight="104" />

                <!-- Slot Capacity Cards -->
                <Label Text="Active Branch Time Slots" Style="{StaticResource SectionTitleLabel}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Slots}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:ServiceTimeSlotDto">
                            <Border Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding SlotDate, Converter={StaticResource VietnamDateTime}}" Style="{StaticResource MonoCodeLabel}" FontSize="12" />
                                            <Label Text="{Binding TimeRangeDisplay}" Style="{StaticResource MonoValueBoldLabel}" FontSize="15" />
                                        </VerticalStackLayout>
                                        <controls:StatusBadgeView Grid.Column="1" Status="Available" LabelOverride="{Binding FreeBadgeLabel}" IsVisible="{Binding IsBlocked, Converter={StaticResource InvertedBool}}" />
                                        <controls:StatusBadgeView Grid.Column="1" Status="Cancelled" LabelOverride="BLOCKED" IsVisible="{Binding IsBlocked}" />
                                    </Grid>

                                    <Label
                                        Text="{Binding BookedRatioLabel}"
                                        Style="{StaticResource SecondaryLabel}" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button
                                            Text="+1 Bay Capacity"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.IncrementSlotCapacityCommand, x:DataType=stf:SlotCapacityPage}"
                                            CommandParameter="{Binding .}" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Block / Reopen"
                                            Style="{StaticResource DarkCarbonButton}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.ToggleBlockSlotCommand, x:DataType=stf:SlotCapacityPage}"
                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
