<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MotorcycleDealer.Mobile.App.Views.Staff.StaffTestDrivePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MotorcycleDealer.Mobile.Core.ViewModels.Staff;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:dto="clr-namespace:MotorcycleDealer.Mobile.Core.Contracts;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:stf="clr-namespace:MotorcycleDealer.Mobile.App.Views.Staff"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:Name="PageRoot"
    x:DataType="vm:StaffTestDriveViewModel"
    Title="Test-Drive Queue">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadTestDrivesCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Style="{StaticResource CarbonHeaderCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="DEMO VIN FLEET &amp; ROWVERSION LOCK" Style="{StaticResource EyebrowLabel}" />
                        <Label
                            Text="Showroom Test-Drive Queue"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Slate50}" />
                        <Label
                            Text="Assign available demo VINs, confirm ride windows, and complete showroom trials."
                            FontSize="12"
                            TextColor="{StaticResource Slate300}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AlertSuccessBanner}" IsVisible="{Binding HasSuccess}">
                    <Label
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SuccessFg}, Dark={StaticResource SuccessFgDark}}" />
                </Border>

                <Border Style="{StaticResource AlertDangerBanner}" IsVisible="{Binding HasError}">
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource DangerFg}, Dark={StaticResource DangerFgDark}}" />
                </Border>

                <!-- Status Filter Chips -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding StatusFilters}" Spacing="8" Padding="0,0,16,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button
                                    Text="{Binding ., Converter={StaticResource HumanizeStatus}}"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.SelectStatusFilterCommand, x:DataType=stf:StaffTestDrivePage}"
                                    CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEqualsMulti}">
                                                    <Binding Path="." />
                                                    <Binding Source="{x:Reference PageRoot}" Path="ViewModel.SelectedStatusFilter" x:DataType="stf:StaffTestDrivePage" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                            <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                            <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Demo VIN Selector & Staff Notes -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="DEMO VIN ASSIGNMENT CONTROLS" Style="{StaticResource EyebrowLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Pick Available Demo VIN"
                                ItemsSource="{Binding DemoUnits}"
                                SelectedItem="{Binding SelectedDemoInventory}"
                                ItemDisplayBinding="{Binding Vin, x:DataType=dto:DealerInventoryDto}" />
                        </Border>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding StaffNotesInput}" Placeholder="Staff handoff or cancellation notes..." />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <controls:ShimmerCardView IsVisible="{Binding IsBusy}" CardHeight="120" />

                <!-- Test-Drive Booking Cards -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TestDrives}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:TestDriveBookingDto">
                            <Border Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding BookingNumber}" Style="{StaticResource MonoValueBoldLabel}" FontSize="14" />
                                        <controls:StatusBadgeView Grid.Column="1" Status="{Binding Status}" />
                                    </Grid>
                                    <Label Text="{Binding MotorcycleModelName}" Style="{StaticResource CardTitleLabel}" />
                                    <Label Text="{Binding CustomerFullName, StringFormat='Rider: {0}'}" Style="{StaticResource SecondaryLabel}" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding PreferredDate, Converter={StaticResource VietnamDateTime}}" Style="{StaticResource MonoCodeLabel}" FontSize="12" />
                                        <Label Text="{Binding ShortStartTime}" Style="{StaticResource MonoCodeLabel}" FontSize="12" />
                                        <Label Text="{Binding ContactPhone}" Style="{StaticResource MonoCodeLabel}" FontSize="12" />
                                    </HorizontalStackLayout>
                                    <Label
                                        Text="{Binding AssignedVin, StringFormat='Assigned Demo VIN: {0}'}"
                                        Style="{StaticResource MonoCodeLabel}"
                                        FontAttributes="Bold"
                                        IsVisible="{Binding AssignedVin, Converter={StaticResource IsNotNullOrEmpty}}" />

                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasStaffActions}">
                                        <Button
                                            Text="Confirm"
                                            MinimumWidthRequest="104"
                                            Style="{StaticResource PrimaryButton}"
                                            IsVisible="{Binding CanStaffConfirm}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.ConfirmTestDriveCommand, x:DataType=stf:StaffTestDrivePage}"
                                            CommandParameter="{Binding .}" />
                                        <Button
                                            Text="Complete"
                                            MinimumWidthRequest="104"
                                            Style="{StaticResource DarkCarbonButton}"
                                            IsVisible="{Binding CanStaffComplete}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.CompleteTestDriveCommand, x:DataType=stf:StaffTestDrivePage}"
                                            CommandParameter="{Binding .}" />
                                        <Button
                                            Text="Cancel"
                                            MinimumWidthRequest="104"
                                            Style="{StaticResource DangerOutlineButton}"
                                            IsVisible="{Binding CanStaffCancel}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.CancelTestDriveCommand, x:DataType=stf:StaffTestDrivePage}"
                                            CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
