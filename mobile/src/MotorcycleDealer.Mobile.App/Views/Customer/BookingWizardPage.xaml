<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MotorcycleDealer.Mobile.App.Views.Customer.BookingWizardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MotorcycleDealer.Mobile.Core.ViewModels.Customer;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:dto="clr-namespace:MotorcycleDealer.Mobile.Core.Contracts;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:cus="clr-namespace:MotorcycleDealer.Mobile.App.Views.Customer"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:Name="PageRoot"
    x:DataType="vm:BookingWizardViewModel"
    Title="Book &amp; Service">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadWizardDataCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Style="{StaticResource CarbonHeaderCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CONCURRENCY-SAFE BAY BOOKING · ROWVERSION" Style="{StaticResource EyebrowLabel}" />
                        <Label
                            Text="3-Step Service Wizard"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Slate50}" />
                        <Label
                            Text="Book workshop bays, recover 409 slot races, rate +25 pts CSAT, and share receipts."
                            FontSize="12"
                            TextColor="{StaticResource Slate300}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 409 RowVersion Slot Conflict Recovery Sheet -->
                <Border Style="{StaticResource AlertDangerBanner}" IsVisible="{Binding HasSlotConflict}">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="409 SLOT CAPACITY CONFLICT — AUTO-RELOADED"
                            FontFamily="Monospace"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource DangerFg}, Dark={StaticResource DangerFgDark}}" />
                        <Label
                            Text="{Binding ConflictRecoveryMessage}"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light={StaticResource DangerFg}, Dark={StaticResource DangerFgDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AlertSuccessBanner}" IsVisible="{Binding HasSuccess}">
                    <Label
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SuccessFg}, Dark={StaticResource SuccessFgDark}}" />
                </Border>

                <Border Style="{StaticResource AlertDangerBanner}" IsVisible="{Binding HasError}">
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource DangerFg}, Dark={StaticResource DangerFgDark}}" />
                </Border>

                <!-- 3-Step Navigation Strip -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Text="1. Vehicle" Clicked="OnStep1Clicked" Style="{StaticResource ChipButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="2. Bay Slot" Clicked="OnStep2Clicked" Style="{StaticResource ChipButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="3. Confirm" Clicked="OnStep3Clicked" Style="{StaticResource ChipButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding CurrentStep}" Value="3">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- STEP 1: Vehicle, Dealership & Service Type -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CurrentStep, Converter={StaticResource EqualsString}, ConverterParameter=1}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="STEP 1 OF 3 — VEHICLE &amp; BRANCH" Style="{StaticResource EyebrowLabel}" />

                        <Label Text="Vehicle (VIN)" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Select Motorcycle"
                                ItemsSource="{Binding Vehicles}"
                                SelectedItem="{Binding SelectedVehicle}"
                                ItemDisplayBinding="{Binding Vin, x:DataType=dto:CustomerVehicleDto}" />
                        </Border>

                        <Label Text="Dealership Branch" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Select Dealer"
                                ItemsSource="{Binding Dealers}"
                                SelectedItem="{Binding SelectedDealer}"
                                ItemDisplayBinding="{Binding Name, x:DataType=dto:DealerDto}"
                                SelectedIndexChanged="OnDealerChanged" />
                        </Border>

                        <Label Text="Service Type" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Service Type"
                                ItemsSource="{Binding ServiceTypes}"
                                SelectedItem="{Binding SelectedServiceType}" />
                        </Border>

                        <Label Text="Current Odometer (km)" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding OdometerAtBookingKm}" Style="{StaticResource MonoEntry}" Keyboard="Numeric" />
                        </Border>

                        <Button Text="Next: Choose Bay Slot" Clicked="OnStep2Clicked" Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <!-- STEP 2: Date & RowVersion Protected Bay Slot Grid -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CurrentStep, Converter={StaticResource EqualsString}, ConverterParameter=2}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="STEP 2 OF 3 — LIVE BAY AVAILABILITY" Style="{StaticResource EyebrowLabel}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Style="{StaticResource InputContainer}">
                                <DatePicker x:Name="SlotDatePicker" DateSelected="OnSlotDateSelected" />
                            </Border>
                            <Button
                                Grid.Column="1"
                                Text="Refresh"
                                Command="{Binding LoadAvailableSlotsCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>

                        <Label Text="Select Open Workshop Bay" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Available Bay Slots"
                                ItemsSource="{Binding AvailableSlots}"
                                SelectedItem="{Binding SelectedSlot}"
                                ItemDisplayBinding="{Binding TimeRangeDisplay, x:DataType=dto:ServiceTimeSlotDto}" />
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailableSlots}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:ServiceTimeSlotDto">
                                    <Border Style="{StaticResource SunkenPanel}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{Binding TimeRangeDisplay}"
                                                    Style="{StaticResource MonoValueBoldLabel}"
                                                    FontSize="14" />
                                                <Label
                                                    Text="{Binding OpenBaysLabel}"
                                                    Style="{StaticResource CaptionLabel}" />
                                            </VerticalStackLayout>
                                            <controls:StatusBadgeView Grid.Column="1" Status="Available" LabelOverride="{Binding FreeBadgeLabel}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Back" Clicked="OnStep1Clicked" Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="1" Text="Next: Review" Clicked="OnStep3Clicked" Style="{StaticResource PrimaryButton}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- STEP 3: Optional Voucher, Notes & Atomic Confirm -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CurrentStep, Converter={StaticResource EqualsString}, ConverterParameter=3}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="STEP 3 OF 3 — VOUCHER &amp; CONFIRM" Style="{StaticResource EyebrowLabel}" />

                        <Label Text="Reserve Service Voucher (Optional)" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="No voucher attached"
                                ItemsSource="{Binding EligibleVouchers}"
                                SelectedItem="{Binding SelectedVoucher}"
                                ItemDisplayBinding="{Binding VoucherCode, x:DataType=dto:CustomerVoucherDto}" />
                        </Border>

                        <Label Text="Reported Notes / Symptoms" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Editor Text="{Binding ReportedNotes}" Placeholder="Describe requested service or symptoms" />
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Back" Clicked="OnStep2Clicked" Style="{StaticResource SecondaryButton}" />
                            <Button
                                Grid.Column="1"
                                Text="Confirm Booking"
                                Command="{Binding ConfirmBookingCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- My Bookings List -->
                <Label Text="My Workshop Bookings" Style="{StaticResource SectionTitleLabel}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyBookings}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:BookingDto">
                            <Border Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding BookingNumber}" Style="{StaticResource MonoValueBoldLabel}" FontSize="14" />
                                        <controls:StatusBadgeView Grid.Column="1" Status="{Binding Status}" />
                                    </Grid>
                                    <Label Text="{Binding MotorcycleModelName}" Style="{StaticResource CardTitleLabel}" />
                                    <Label Text="{Binding DealerName}" Style="{StaticResource SecondaryLabel}" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding SlotDate, Converter={StaticResource VietnamDateTime}}" Style="{StaticResource MonoCodeLabel}" FontSize="12" />
                                        <Label Text="{Binding ShortStartTime}" Style="{StaticResource MonoCodeLabel}" FontSize="12" />
                                        <Label Text="{Binding FormattedServiceType}" Style="{StaticResource CaptionLabel}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                    <Button
                                        Text="Cancel Booking"
                                        Style="{StaticResource DangerOutlineButton}"
                                        IsVisible="{Binding CanCustomerCancel}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.CancelBookingCommand, x:DataType=cus:BookingWizardPage}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Completed Invoices: Receipt Share & +25 Pts 5-Star CSAT Review -->
                <Label Text="Completed Service Receipts &amp; +25 Pts CSAT" Style="{StaticResource SectionTitleLabel}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyServiceInvoices}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:ServiceInvoiceDto">
                            <Border Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding InvoiceNumber}" Style="{StaticResource MonoValueBoldLabel}" FontSize="14" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding NetPaidAmount, Converter={StaticResource VndCurrency}}"
                                            Style="{StaticResource MonoValueBoldLabel}"
                                            TextColor="{StaticResource BrandPrimary}" />
                                    </Grid>
                                    <Label Text="{Binding MotorcycleModelName}" Style="{StaticResource CardTitleLabel}" />
                                    <Label Text="{Binding PointsEarned, Converter={StaticResource PointsDisplay}, ConverterParameter=signed}" Style="{StaticResource MonoCodeLabel}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button
                                            Text="Share Receipt"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.LoadAndShareServiceReceiptCommand, x:DataType=cus:BookingWizardPage}"
                                            CommandParameter="{Binding .}" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Rate +25 Pts"
                                            Style="{StaticResource PrimaryButton}"
                                            Clicked="OnPickInvoiceForReviewClicked"
                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Offline Verifiable Receipt QR Preview -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding ActiveServiceReceipt, Converter={StaticResource IsNotNull}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="IMMUTABLE SERVICE RECEIPT QR" Style="{StaticResource EyebrowLabel}" />
                        <controls:QrCodeDisplayView
                            Payload="{Binding ReceiptQrPayload}"
                            Title="{Binding ActiveServiceReceipt.ReceiptNumber}"
                            Caption="{Binding ActiveServiceReceipt.VerificationCode}" />
                    </VerticalStackLayout>
                </Border>

                <!-- +25 AvailablePoints 5-Star CSAT Review Composer -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding SelectedInvoiceForReview, Converter={StaticResource IsNotNull}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="5-STAR CSAT REVIEW · +25 AVAILABLE POINTS" Style="{StaticResource EyebrowLabel}" />
                        <Label
                            Text="{Binding SelectedInvoiceForReview.InvoiceNumber, StringFormat='Rating Invoice {0}'}"
                            Style="{StaticResource CardTitleLabel}" />

                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Button Text="1★" Clicked="OnRate1Clicked" Style="{StaticResource ChipButton}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ReviewRating}" Value="1">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Text="2★" Clicked="OnRate2Clicked" Style="{StaticResource ChipButton}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ReviewRating}" Value="2">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2" Text="3★" Clicked="OnRate3Clicked" Style="{StaticResource ChipButton}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ReviewRating}" Value="3">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="3" Text="4★" Clicked="OnRate4Clicked" Style="{StaticResource ChipButton}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ReviewRating}" Value="4">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="4" Text="5★" Clicked="OnRate5Clicked" Style="{StaticResource ChipButton}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ReviewRating}" Value="5">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <Label
                            Text="{Binding ReviewRating, StringFormat='Selected Rating: {0} / 5 Stars'}"
                            Style="{StaticResource MonoCodeLabel}"
                            FontAttributes="Bold" />

                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding ReviewQualityTags}" Placeholder="Optional comma-separated quality tags" />
                        </Border>

                        <Border Style="{StaticResource InputContainer}">
                            <Editor Text="{Binding ReviewComment}" Placeholder="Share your workshop bay experience..." />
                        </Border>

                        <Button
                            Text="Submit CSAT Review (+25 Pts)"
                            Command="{Binding SubmitCsatReviewCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
