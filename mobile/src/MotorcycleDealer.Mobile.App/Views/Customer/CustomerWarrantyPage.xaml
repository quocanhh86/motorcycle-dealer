<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MotorcycleDealer.Mobile.App.Views.Customer.CustomerWarrantyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MotorcycleDealer.Mobile.Core.ViewModels.Customer;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:dto="clr-namespace:MotorcycleDealer.Mobile.Core.Contracts;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    x:DataType="vm:CustomerWarrantyViewModel"
    Title="VIN Warranty">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadWarrantyDataCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Style="{StaticResource CarbonHeaderCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="OEM VIN WARRANTY COVERAGE" Style="{StaticResource EyebrowLabel}" />
                        <Label
                            Text="VIN Warranty Claims"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Slate50}" />
                        <Label
                            Text="File defect claims directly to any flagship dealership and track real-time adjudication."
                            FontSize="12"
                            TextColor="{StaticResource Slate300}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AlertSuccessBanner}" IsVisible="{Binding HasSuccess}">
                    <Label
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SuccessFg}, Dark={StaticResource SuccessFgDark}}" />
                </Border>

                <Border Style="{StaticResource AlertDangerBanner}" IsVisible="{Binding HasError}">
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource DangerFg}, Dark={StaticResource DangerFgDark}}" />
                </Border>

                <!-- File Claim Form Card -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="FILE OEM WARRANTY CLAIM" Style="{StaticResource EyebrowLabel}" VerticalTextAlignment="Center" />
                            <controls:StatusBadgeView Grid.Column="1" Status="Eligible" IsVisible="{Binding IsWithinOemCoverage}" />
                            <controls:StatusBadgeView Grid.Column="1" Status="OutOfCoverage" LabelOverride="OUT OF LIMIT" IsVisible="{Binding IsWithinOemCoverage, Converter={StaticResource InvertedBool}}" />
                        </Grid>

                        <Label Text="{Binding WarrantyEligibilitySummary}" Style="{StaticResource SecondaryLabel}" />

                        <Label Text="Vehicle (VIN)" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Select Vehicle"
                                ItemsSource="{Binding Vehicles}"
                                SelectedItem="{Binding SelectedVehicle}"
                                ItemDisplayBinding="{Binding Vin, x:DataType=dto:CustomerVehicleDto}" />
                        </Border>

                        <Label Text="Servicing Dealership" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Picker
                                Title="Select Branch"
                                ItemsSource="{Binding Dealers}"
                                SelectedItem="{Binding SelectedDealer}"
                                ItemDisplayBinding="{Binding Name, x:DataType=dto:DealerDto}" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Odometer (km)" Style="{StaticResource CaptionLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry Text="{Binding OdometerAtClaimKm}" Style="{StaticResource MonoEntry}" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Defect Category" Style="{StaticResource CaptionLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Picker
                                        ItemsSource="{Binding DefectCategories}"
                                        SelectedItem="{Binding SelectedDefectCategory}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Defect Symptom Description (min 10 chars)" Style="{StaticResource CaptionLabel}" />
                        <Border Style="{StaticResource InputContainer}">
                            <Editor Text="{Binding SymptomDescription}" Placeholder="Describe fault symptoms, warning lights, or abnormal noise..." />
                        </Border>

                        <Button
                            Text="Submit VIN Warranty Claim"
                            Command="{Binding SubmitWarrantyClaimCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <controls:ShimmerCardView IsVisible="{Binding IsBusy}" CardHeight="110" />

                <!-- My Claims History -->
                <Label Text="Submitted Warranty Claims" Style="{StaticResource SectionTitleLabel}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Claims}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:WarrantyClaimDto">
                            <Border Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding ClaimNumber}" Style="{StaticResource MonoValueBoldLabel}" FontSize="14" />
                                        <controls:StatusBadgeView Grid.Column="1" Status="{Binding Status}" />
                                    </Grid>
                                    <Label Text="{Binding MotorcycleModelName}" Style="{StaticResource CardTitleLabel}" />
                                    <Label Text="{Binding Vin, StringFormat='VIN: {0}'}" Style="{StaticResource MonoCodeLabel}" FontSize="12" />
                                    <Label Text="{Binding DefectCategory, StringFormat='Category: {0}'}" Style="{StaticResource SecondaryLabel}" />
                                    <Label Text="{Binding SymptomDescription}" Style="{StaticResource SecondaryLabel}" />
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CoveredAmountVnd, Converter={StaticResource IsGreaterThanZero}}">
                                        <Label Text="OEM Covered Amount" Style="{StaticResource CaptionLabel}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding CoveredAmountVnd, Converter={StaticResource VndCurrency}}"
                                            Style="{StaticResource MonoCodeLabel}"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource SuccessAccent}" />
                                    </Grid>
                                    <Label
                                        Text="{Binding ResolutionNotes, StringFormat='Resolution: {0}'}"
                                        Style="{StaticResource CaptionLabel}"
                                        IsVisible="{Binding ResolutionNotes, Converter={StaticResource IsNotNullOrEmpty}}" />
                                    <Label
                                        Text="{Binding RejectionReason, StringFormat='Rejected: {0}'}"
                                        Style="{StaticResource CaptionLabel}"
                                        TextColor="{StaticResource DangerAccent}"
                                        IsVisible="{Binding RejectionReason, Converter={StaticResource IsNotNullOrEmpty}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
