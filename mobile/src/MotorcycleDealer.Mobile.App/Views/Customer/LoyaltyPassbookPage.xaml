<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MotorcycleDealer.Mobile.App.Views.Customer.LoyaltyPassbookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MotorcycleDealer.Mobile.Core.ViewModels.Customer;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:dto="clr-namespace:MotorcycleDealer.Mobile.Core.Contracts;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:loc="clr-namespace:MotorcycleDealer.Mobile.Core.Localization;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:cus="clr-namespace:MotorcycleDealer.Mobile.App.Views.Customer"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    xmlns:behaviors="clr-namespace:MotorcycleDealer.Mobile.App.Behaviors"
    xmlns:icons="clr-namespace:MotorcycleDealer.Mobile.App.Icons"
    SafeAreaEdges="All"
    x:Name="PageRoot"
    x:DataType="vm:LoyaltyPassbookViewModel"
    Title="{Binding Loc.LoyaltyPageTitle}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#020617" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadPassbookCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Brushed Metallic 4-Tier Passbook Card -->
                <controls:LoyaltyPassbookCardView
                    x:Name="PassbookCard"
                    MemberName="{Binding Wallet.CustomerFullName, FallbackValue='', TargetNullValue=''}"
                    TierName="{Binding TierCode}"
                    TierMultiplier="{Binding Wallet.PointsMultiplier, FallbackValue=1.00}"
                    AvailablePoints="{Binding Wallet.AvailablePoints, FallbackValue=0}"
                    LifetimeQualifyingPoints="{Binding Wallet.LifetimeQualifyingPoints, FallbackValue=0}"
                    TierProgressRatio="{Binding TierProgressRatio}"
                    NextTierHint="{Binding NextTierHint}"
                    SyncCaption="{Binding SyncAgeLabel}" />

                <!-- Lifetime Qualifying Spend & Two-Step Formula Strip -->
                <Border Style="{StaticResource SunkenPanel}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Loc.LoyaltyLifetimeSpendLabel}" Style="{StaticResource SecondaryLabel}" />
                            <Label Grid.Column="1" Text="{Binding FormattedLifetimeSpent}" Style="{StaticResource MonoCodeLabel}" FontFamily="JetBrainsMonoSemiBold" />
                        </Grid>
                        <Label Text="{Binding Loc.LoyaltyFormulaCaption}" Style="{StaticResource CaptionLabel}" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4-Tier Loyalty Multiplier Roadmap Strip -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding Tiers.Count, Converter={StaticResource IsGreaterThanZero}}">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tiers}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:LoyaltyTierDto">
                                <Border
                                    Padding="12,8"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1.5"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEqualsMulti}">
                                                    <Binding Path="TierCode" />
                                                    <Binding Source="{x:Reference PageRoot}" Path="ViewModel.TierCode" x:DataType="cus:LoyaltyPassbookPage" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding TierCode, Converter={StaticResource HumanizeStatus}, ConverterParameter=LoyaltyTier}" FontFamily="SpaceGroteskSemiBold" FontSize="12" />
                                            <Label Text="{Binding PointsMultiplier, StringFormat='{0:0.00}x'}" FontFamily="JetBrainsMonoSemiBold" FontSize="12" TextColor="{StaticResource BrandPrimary}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding MinQualifyingPoints, StringFormat='{0:N0}+'}" Style="{StaticResource CaptionLabel}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Offline Passbook Mode Banner -->
                <Border Style="{StaticResource AlertWarningBanner}" IsVisible="{Binding IsOfflineBannerVisible}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label
                            Text="{x:Static icons:PhosphorIcons.WifiSlash}"
                            FontFamily="Phosphor"
                            FontSize="18"
                            TextColor="{AppThemeBinding Light={StaticResource WarningFg}, Dark={StaticResource WarningFgDark}}"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding OfflinePassbookBannerText}"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource WarningFg}, Dark={StaticResource WarningFgDark}}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Success Banner with Lottie Check -->
                <Border Style="{StaticResource AlertSuccessBanner}" IsVisible="{Binding HasSuccess}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:LottieOrIconView
                            IsVisible="{Binding HasSuccess}"
                            LottieFile="lottie_success_check.json"
                            FallbackGlyph="{x:Static icons:PhosphorIcons.CheckCircle}"
                            FallbackColor="{StaticResource SuccessAccent}"
                            Size="28"
                            RepeatCount="0" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding SuccessMessage}"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light={StaticResource SuccessFg}, Dark={StaticResource SuccessFgDark}}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Error Retry Banner -->
                <controls:ErrorRetryBannerView
                    IsVisible="{Binding HasError}"
                    Message="{Binding ErrorMessage}"
                    RetryText="{Binding Loc.Common_Retry}"
                    RetryCommand="{Binding LoadPassbookCommand}" />

                <!-- 4 Segmented Passbook Tabs -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Button Text="{Binding Loc.LoyaltyTabVouchers}" Command="{Binding SelectSectionCommand}" CommandParameter="Vouchers" Style="{StaticResource ChipButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSection}" Value="Vouchers">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="{Binding Loc.LoyaltyTabStore}" Command="{Binding SelectSectionCommand}" CommandParameter="Store" Style="{StaticResource ChipButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSection}" Value="Store">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="{Binding Loc.LoyaltyTabLedger}" Command="{Binding SelectSectionCommand}" CommandParameter="Ledger" Style="{StaticResource ChipButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSection}" Value="Ledger">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="3" Text="{Binding Loc.LoyaltyTabReceipts}" Command="{Binding SelectSectionCommand}" CommandParameter="Receipts" Style="{StaticResource ChipButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSection}" Value="Receipts">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Multi-Variant Loading Skeleton -->
                <controls:SkeletonLoaderView
                    Variant="PassbookCard"
                    Count="2"
                    IsVisible="{Binding IsBusy}" />

                <!-- SECTION 1: Offline-Accessible QR Voucher Wallet -->
                <VerticalStackLayout
                    Spacing="12"
                    IsVisible="{Binding SelectedSection, Converter={StaticResource EqualsString}, ConverterParameter=Vouchers}">

                    <Border Style="{StaticResource DoubleBezelOuter}" IsVisible="{Binding SelectedVoucher, Converter={StaticResource IsNotNull}}">
                        <Border Style="{StaticResource DoubleBezelInner}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Loc.LoyaltyCounterQrEyebrow}" Style="{StaticResource EyebrowLabel}" />
                                <controls:QrCodeDisplayView
                                    Payload="{Binding SelectedVoucherQrPayload}"
                                    Title="{Binding SelectedVoucher.Title}"
                                    Caption="{Binding SelectedVoucher.VoucherCode}" />
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label
                                        Text="{x:Static icons:PhosphorIcons.Clock}"
                                        FontFamily="Phosphor"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Text="{Binding SelectedVoucher.ExpiresAtUtc, Converter={StaticResource VietnamDateTime}}"
                                        Style="{StaticResource CaptionLabel}"
                                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Border>

                    <controls:EmptyStateView
                        IsVisible="{Binding MyVouchers.Count, Converter={StaticResource EqualsString}, ConverterParameter=0}"
                        IconGlyph="{x:Static icons:PhosphorIcons.Ticket}"
                        LottieFile="lottie_empty_garage.json"
                        Title="{Binding Loc.LoyaltyEmptyVouchersTitle}"
                        Subtitle="{Binding Loc.LoyaltyEmptyVouchersDesc}"
                        ActionText="{Binding Loc.Common_Refresh}"
                        ActionCommand="{Binding LoadPassbookCommand}">
                        <controls:EmptyStateView.Triggers>
                            <DataTrigger TargetType="controls:EmptyStateView" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </controls:EmptyStateView.Triggers>
                    </controls:EmptyStateView>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyVouchers}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:CustomerVoucherDto">
                                <Border x:Name="VoucherCardRoot" Style="{StaticResource DoubleBezelOuter}">
                                    <Border.Behaviors>
                                        <behaviors:ApexPressBehavior
                                            PressedScale="0.97"
                                            PressedOpacity="0.92"
                                            PressedAnimationDuration="110"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.SelectVoucherForQrCommand, x:DataType=cus:LoyaltyPassbookPage}"
                                            CommandParameter="{Binding Source={x:Reference VoucherCardRoot}, Path=BindingContext, x:DataType=Border}"
                                            ShouldMakeChildrenInputTransparent="True" />
                                    </Border.Behaviors>
                                    <Border Style="{StaticResource DoubleBezelInner}">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding VoucherCode}" Style="{StaticResource MonoValueBoldLabel}" FontSize="14" />
                                                <controls:StatusBadgeView Grid.Column="1" Status="{Binding EffectiveStatus}" />
                                            </Grid>
                                            <Label Text="{Binding Title}" Style="{StaticResource CardTitleLabel}" />
                                            <Label Text="{Binding LocalizedScope}" Style="{StaticResource SecondaryLabel}" />
                                            <Border Style="{StaticResource SecondaryTouchCard}">
                                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label
                                                        Text="{x:Static icons:PhosphorIcons.QrCode}"
                                                        FontFamily="Phosphor"
                                                        FontSize="16"
                                                        TextColor="{StaticResource BrandPrimary}"
                                                        VerticalTextAlignment="Center" />
                                                    <Label
                                                        Text="{Binding Source={x:Static loc:LocalizationService.Current}, Path=LoyaltyDisplayQrCta, x:DataType=loc:LocalizationService}"
                                                        FontFamily="BeVietnamProSemiBold"
                                                        FontSize="13"
                                                        VerticalTextAlignment="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION 2: Online Voucher Catalog Store -->
                <VerticalStackLayout
                    Spacing="10"
                    IsVisible="{Binding SelectedSection, Converter={StaticResource EqualsString}, ConverterParameter=Store}">

                    <controls:EmptyStateView
                        IsVisible="{Binding VoucherStore.Count, Converter={StaticResource EqualsString}, ConverterParameter=0}"
                        IconGlyph="{x:Static icons:PhosphorIcons.Tag}"
                        LottieFile="lottie_empty_garage.json"
                        Title="{Binding Loc.LoyaltyEmptyStoreTitle}"
                        Subtitle="{Binding Loc.LoyaltyEmptyVouchersDesc}"
                        ActionText="{Binding Loc.Common_Refresh}"
                        ActionCommand="{Binding LoadPassbookCommand}">
                        <controls:EmptyStateView.Triggers>
                            <DataTrigger TargetType="controls:EmptyStateView" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </controls:EmptyStateView.Triggers>
                    </controls:EmptyStateView>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding VoucherStore}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:VoucherCatalogDto">
                                <Border Style="{StaticResource DoubleBezelOuter}">
                                    <Border Style="{StaticResource DoubleBezelInner}">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding Title}" Style="{StaticResource CardTitleLabel}" />
                                                <controls:StatusBadgeView Grid.Column="1" Status="Info" LabelOverride="{Binding LocalizedMinTier}" />
                                            </Grid>
                                            <Label Text="{Binding Description}" Style="{StaticResource SecondaryLabel}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label
                                                    Text="{Binding PointsCost, Converter={StaticResource PointsDisplay}}"
                                                    Style="{StaticResource MonoValueBoldLabel}"
                                                    TextColor="{StaticResource BrandPrimary}"
                                                    VerticalTextAlignment="Center" />
                                                <Button
                                                    Grid.Column="1"
                                                    Text="{Binding Source={x:Static loc:LocalizationService.Current}, Path=LoyaltyRedeemCta, x:DataType=loc:LocalizationService}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.RedeemVoucherCommand, x:DataType=cus:LoyaltyPassbookPage}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION 3: Immutable Append-Only PointLedgerEntries -->
                <VerticalStackLayout
                    Spacing="10"
                    IsVisible="{Binding SelectedSection, Converter={StaticResource EqualsString}, ConverterParameter=Ledger}">

                    <controls:EmptyStateView
                        IsVisible="{Binding LedgerEntries.Count, Converter={StaticResource EqualsString}, ConverterParameter=0}"
                        IconGlyph="{x:Static icons:PhosphorIcons.List}"
                        LottieFile="lottie_empty_garage.json"
                        Title="{Binding Loc.LoyaltyEmptyLedgerTitle}"
                        Subtitle="{Binding Loc.LoyaltyEmptyLedgerDesc}">
                        <controls:EmptyStateView.Triggers>
                            <DataTrigger TargetType="controls:EmptyStateView" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </controls:EmptyStateView.Triggers>
                    </controls:EmptyStateView>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LedgerEntries}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:PointLedgerEntryDto">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding LocalizedTransactionType}" Style="{StaticResource CardTitleLabel}" FontSize="14" />
                                            <Label Text="{Binding Notes}" Style="{StaticResource SecondaryLabel}" />
                                            <Label
                                                Text="{Binding CreatedAtUtc, Converter={StaticResource VietnamDateTime}}"
                                                Style="{StaticResource MonoCodeLabel}"
                                                FontSize="11" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                            <Label
                                                Text="{Binding PointsDelta, Converter={StaticResource PointsDisplay}, ConverterParameter=signed}"
                                                Style="{StaticResource MonoValueBoldLabel}"
                                                HorizontalTextAlignment="End" />
                                            <Label Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding BalanceAfter, StringFormat='{0:N0}'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Source={x:Static loc:LocalizationService.Current}, Path=Common_PointsShort, x:DataType=loc:LocalizationService}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION 4: Immutable Showroom Sales Receipts -->
                <VerticalStackLayout
                    Spacing="10"
                    IsVisible="{Binding SelectedSection, Converter={StaticResource EqualsString}, ConverterParameter=Receipts}">

                    <Border Style="{StaticResource DoubleBezelOuter}" IsVisible="{Binding ActiveSalesReceipt, Converter={StaticResource IsNotNull}}">
                        <Border Style="{StaticResource DoubleBezelInner}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Loc.LoyaltySalesReceiptQrEyebrow}" Style="{StaticResource EyebrowLabel}" />
                                <controls:QrCodeDisplayView
                                    Payload="{Binding ActiveReceiptQrPayload}"
                                    Title="{Binding ActiveSalesReceipt.ReceiptNumber}"
                                    Caption="{Binding ActiveSalesReceipt.VerificationCode}" />
                            </VerticalStackLayout>
                        </Border>
                    </Border>

                    <controls:EmptyStateView
                        IsVisible="{Binding MySalesOrders.Count, Converter={StaticResource EqualsString}, ConverterParameter=0}"
                        IconGlyph="{x:Static icons:PhosphorIcons.Receipt}"
                        LottieFile="lottie_empty_garage.json"
                        Title="{Binding Loc.LoyaltyEmptyReceiptsTitle}"
                        Subtitle="{Binding Loc.Common_NoData}">
                        <controls:EmptyStateView.Triggers>
                            <DataTrigger TargetType="controls:EmptyStateView" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </controls:EmptyStateView.Triggers>
                    </controls:EmptyStateView>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MySalesOrders}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:SalesOrderDto">
                                <Border Style="{StaticResource DoubleBezelOuter}">
                                    <Border Style="{StaticResource DoubleBezelInner}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding OrderNumber}" Style="{StaticResource MonoValueBoldLabel}" FontSize="14" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding FinalAmount, Converter={StaticResource VndCurrency}}"
                                                    Style="{StaticResource MonoValueBoldLabel}"
                                                    TextColor="{StaticResource BrandPrimary}" />
                                            </Grid>
                                            <Label Text="{Binding MotorcycleModelName}" Style="{StaticResource CardTitleLabel}" />
                                            <Label Style="{StaticResource MonoCodeLabel}" FontSize="12">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Source={x:Static loc:LocalizationService.Current}, Path=Common_VinLabel, x:DataType=loc:LocalizationService}" />
                                                        <Span Text=": " />
                                                        <Span Text="{Binding Vin}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Button
                                                Text="{Binding Source={x:Static loc:LocalizationService.Current}, Path=LoyaltyShareSalesReceiptCta, x:DataType=loc:LocalizationService}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.LoadAndShareSalesReceiptCommand, x:DataType=cus:LoyaltyPassbookPage}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
