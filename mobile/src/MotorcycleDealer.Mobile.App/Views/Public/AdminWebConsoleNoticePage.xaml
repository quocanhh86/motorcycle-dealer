<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MotorcycleDealer.Mobile.App.Views.Public.AdminWebConsoleNoticePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MotorcycleDealer.Mobile.Core.ViewModels.Public;assembly=MotorcycleDealer.Mobile.Core"
    xmlns:pub="clr-namespace:MotorcycleDealer.Mobile.App.Views.Public"
    xmlns:controls="clr-namespace:MotorcycleDealer.Mobile.App.Controls"
    xmlns:icons="clr-namespace:MotorcycleDealer.Mobile.App.Icons"
    SafeAreaEdges="All"
    x:Name="PageRoot"
    x:DataType="vm:AdminWebConsoleNoticeViewModel"
    Title="{Binding Loc.AdminNoticePageTitle}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#020617" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Center">

            <!-- Carbon Admin Header with 1-Tap VI|EN & Light/Dark Toggles -->
            <Border Style="{StaticResource CarbonHeaderCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <controls:StatusBadgeView
                            Status="Info"
                            LabelOverride="{Binding Loc.AdminNoticeBadge}"
                            HorizontalOptions="Start" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Border
                                BackgroundColor="{StaticResource Slate800}"
                                Stroke="{StaticResource Slate700}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="10,6"
                                MinimumHeightRequest="48"
                                SemanticProperties.Description="{Binding Loc.ToolbarLanguage}">
                                <Border.Behaviors>
                                    <toolkit:TouchBehavior
                                        PressedScale="0.95"
                                        PressedAnimationDuration="110"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.ToggleLanguageCommand, x:DataType=pub:AdminWebConsoleNoticePage}"
                                        ShouldMakeChildrenInputTransparent="True" />
                                </Border.Behaviors>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label
                                        Text="{x:Static icons:PhosphorIcons.Translate}"
                                        FontFamily="Phosphor"
                                        FontSize="14"
                                        TextColor="{StaticResource BrandPrimaryHoverDark}"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Text="{Binding LanguageToggleText}"
                                        FontFamily="JetBrainsMonoSemiBold"
                                        FontSize="11"
                                        TextColor="{StaticResource Slate50}"
                                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                BackgroundColor="{StaticResource Slate800}"
                                Stroke="{StaticResource Slate700}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="10,6"
                                MinimumHeightRequest="48"
                                SemanticProperties.Description="{Binding Loc.ToolbarTheme}">
                                <Border.Behaviors>
                                    <toolkit:TouchBehavior
                                        PressedScale="0.95"
                                        PressedAnimationDuration="110"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.ToggleThemeCommand, x:DataType=pub:AdminWebConsoleNoticePage}"
                                        ShouldMakeChildrenInputTransparent="True" />
                                </Border.Behaviors>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label
                                        Text="{x:Static icons:PhosphorIcons.Moon}"
                                        FontFamily="Phosphor"
                                        FontSize="14"
                                        TextColor="{StaticResource TierGoldAccentDark}"
                                        VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Text" Value="{x:Static icons:PhosphorIcons.Sun}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label
                                        Text="{Binding ThemeToggleText}"
                                        FontFamily="BeVietnamProSemiBold"
                                        FontSize="11"
                                        TextColor="{StaticResource Slate50}"
                                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                    <Label
                        Text="{Binding Loc.AdminNoticeTitle}"
                        FontFamily="SpaceGroteskBold"
                        FontSize="22"
                        TextColor="{StaticResource Slate50}" />
                    <Label
                        Text="{Binding SignedInAsLabel}"
                        FontFamily="JetBrainsMonoMedium"
                        FontSize="12"
                        TextColor="{StaticResource Slate300}" />
                </VerticalStackLayout>
            </Border>

            <!-- Error Retry Banner -->
            <controls:ErrorRetryBannerView
                IsVisible="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                RetryText="{Binding Loc.Common_Retry}"
                RetryCommand="{Binding OpenWebConsoleCommand}" />

            <!-- Web HQ Boundary Notice Card (Double-Bezel Frame) -->
            <Border Style="{StaticResource DoubleBezelOuter}">
                <Border Style="{StaticResource DoubleBezelInner}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label
                                Text="{x:Static icons:PhosphorIcons.ChartBar}"
                                FontFamily="Phosphor"
                                FontSize="22"
                                TextColor="{StaticResource BrandPrimary}"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding Loc.AdminNoticeWhyTitle}"
                                Style="{StaticResource SectionTitleLabel}"
                                VerticalTextAlignment="Center" />
                        </Grid>

                        <Label Text="{Binding NoticeDescription}" Style="{StaticResource SecondaryLabel}" />
                        <Label Text="{Binding Loc.AdminNoticeMobileBoundaryNote}" Style="{StaticResource CaptionLabel}" />

                        <Border Style="{StaticResource SunkenPanel}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Loc.AdminNoticeDesktopUrlLabel}" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding WebConsoleUrl}" Style="{StaticResource MonoCodeLabel}" FontFamily="JetBrainsMonoSemiBold" />
                            </VerticalStackLayout>
                        </Border>

                        <controls:SkeletonLoaderView
                            Variant="ListRow"
                            Count="1"
                            IsVisible="{Binding IsBusy}" />

                        <!-- Tactile Primary Pill CTA -->
                        <Border
                            Style="{StaticResource PrimaryPillCta}"
                            SemanticProperties.Description="{Binding Loc.AdminNoticeOpenWebCta}">
                            <Border.Behaviors>
                                <toolkit:TouchBehavior
                                    PressedScale="0.97"
                                    PressedOpacity="0.90"
                                    PressedAnimationDuration="110"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=ViewModel.OpenWebConsoleCommand, x:DataType=pub:AdminWebConsoleNoticePage}"
                                    ShouldMakeChildrenInputTransparent="True" />
                            </Border.Behaviors>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label
                                    Text="{Binding Loc.AdminNoticeOpenWebCta}"
                                    FontFamily="BeVietnamProSemiBold"
                                    FontSize="14"
                                    TextColor="{StaticResource PureWhite}"
                                    VerticalTextAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource PrimaryPillCtaWell}">
                                    <Label
                                        Text="{x:Static icons:PhosphorIcons.ArrowSquareOut}"
                                        FontFamily="Phosphor"
                                        FontSize="16"
                                        TextColor="{StaticResource PureWhite}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Button
                            Text="{Binding Loc.AdminNoticeSwitchAccountCta}"
                            Command="{Binding SignOutAndSwitchAccountCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
