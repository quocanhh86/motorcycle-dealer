      { "id": 28, "code": "Permissions.Notifications.ViewOwn", "module": "Notifications", "boundedContext": "Notifications", "roles": ["Customer", "DealerStaff", "Admin"], "anonymousAllowed": false, "dealerScoped": false, "ownerScoped": true, "scopeRule": "Read and mark-as-read personal notifications (RecipientUserId == CurrentUser.UserId)." },
