  "loyalty": {
    "baseUnitVnd": 10000,
    "formula": "PointsEarned = Math.floor(Math.floor(NetPaidAmount / 10000) * TierMultiplier)",
    "csharpFormula": "(int)Math.Floor(Math.Floor(NetPaidAmount / 10_000m) * TierMultiplier)",
    "preTransactionMultiplierRule": "PointsEarned uses the customer's active CurrentTier.PointsMultiplier at payment time; crossing higher tier thresholds upgrades CurrentTierId immediately for subsequent transactions.",
    "redemptionRule": "Voucher redemption deducts AvailablePoints ONLY; LifetimeQualifyingPoints never decreases on voucher redemption.",
    "reviewBonusRule": "Submitting a post-service CSAT ServiceReview awards +25 bonus points to AvailablePoints ONLY (LedgerTransactionType.ServiceReviewBonus); LifetimeQualifyingPoints is never modified by review bonuses.",
    "idempotencyKeyPatterns": {
      "salesOrderEarn": "SALES_ORDER:{SalesOrderId}:EARN",
      "serviceInvoiceEarn": "SERVICE_INVOICE:{ServiceInvoiceId}:EARN",
      "voucherRedeemSpend": "VOUCHER_REDEEM:{CustomerVoucherId}:SPEND",
      "serviceReviewBonus": "SERVICE_REVIEW:{ServiceInvoiceId}:BONUS"
    },
    "tiers": [
      { "code": "Bronze", "rankOrder": 1, "minQualifyingPoints": 0, "multiplier": 1.0 },
      { "code": "Silver", "rankOrder": 2, "minQualifyingPoints": 500, "multiplier": 1.2 },
      { "code": "Gold", "rankOrder": 3, "minQualifyingPoints": 2000, "multiplier": 1.5 },
      { "code": "Platinum", "rankOrder": 4, "minQualifyingPoints": 5000, "multiplier": 2.0 }
    ]
  },
  "signalr": {
    "hubPath": "/hubs/notifications",
    "hubContract": "NotificationHub : Hub<INotificationClient>",
    "authHandshake": "JWT access_token query string extracted exclusively on /hubs/notifications; server-enforced group join on OnConnectedAsync",
    "groups": [
      "user-{userId}",
      "dealer-{dealerId}",
      "role-Admin"
    ],
    "reconnectScheduleMs": [0, 2000, 5000, 10000, 30000],
    "events": [
      { "name": "BookingCreated", "targetGroups": ["dealer-{dealerId}", "role-Admin"], "trigger": "Customer creates ServiceBookings", "spaAction": "Prepends highlighted booking card into DealerStaff Live Workbench + plays toast without page refresh" },
      { "name": "BookingStatusChanged", "targetGroups": ["user-{customerId}", "dealer-{dealerId}"], "trigger": "Staff updates booking status or customer cancels", "spaAction": "Updates status badge in Customer Booking list & syncs peer DealerStaff tabs" },
      { "name": "MaintenanceReminderTriggered", "targetGroups": ["user-{customerId}"], "trigger": "VinMaintenanceReminderWorker detects due milestone", "spaAction": "Displays due maintenance banner in Customer VIN Garage + increments bell counter" },
      { "name": "LoyaltyPointsUpdated", "targetGroups": ["user-{customerId}"], "trigger": "SalesOrders, ServiceInvoices, Voucher redeem, or Admin adjustment", "spaAction": "Animates AvailablePoints & LifetimeQualifyingPoints balance in Customer Loyalty header" },
      { "name": "TierUpgraded", "targetGroups": ["user-{customerId}"], "trigger": "LifetimeQualifyingPoints crosses Silver/Gold/Platinum threshold", "spaAction": "Displays Tier-Up celebration toast/modal with new multiplier" },
      { "name": "TestDriveCreated", "targetGroups": ["dealer-{dealerId}", "role-Admin"], "trigger": "Customer creates TestDriveBookings", "spaAction": "Prepends incoming test-drive card into DealerStaff Test-Drives screen + plays toast without page refresh" },
      { "name": "TestDriveStatusChanged", "targetGroups": ["user-{customerId}", "dealer-{dealerId}"], "trigger": "Staff confirms/completes/cancels test-drive or customer cancels", "spaAction": "Updates status badge & demo VIN in Customer Test-Drives list & syncs peer DealerStaff tabs without refresh" },
      { "name": "ServiceReviewSubmitted", "targetGroups": ["dealer-{dealerId}", "role-Admin"], "trigger": "Customer submits 1-5 star ServiceReview on settled ServiceInvoice", "spaAction": "Prepends incoming CSAT review card into DealerStaff Warranty & Reviews desk + plays toast without page refresh" },
      { "name": "WarrantyClaimCreated", "targetGroups": ["dealer-{dealerId}", "role-Admin"], "trigger": "Customer files VIN WarrantyClaim within 36m / 30,000km OEM coverage", "spaAction": "Prepends incoming VIN warranty claim into DealerStaff Warranty & Reviews desk + plays toast without page refresh" },
      { "name": "WarrantyClaimStatusChanged", "targetGroups": ["user-{customerId}", "dealer-{dealerId}", "role-Admin"], "trigger": "Staff/Admin transitions WarrantyClaim status (UnderReview, Approved, Completed, Rejected)", "spaAction": "Updates warranty stepper, covered OEM part & resolution notes in Customer Warranty portal & syncs staff/admin tabs without refresh" }
    ]
  },
