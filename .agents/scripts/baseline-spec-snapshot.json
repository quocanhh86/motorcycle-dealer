      { "id": 33, "code": "Permissions.Analytics.ViewAllDealers", "module": "Analytics", "boundedContext": "Platform & Admin", "roles": ["Admin"], "anonymousAllowed": false, "dealerScoped": false, "ownerScoped": false, "scopeRule": "Access cross-dealer Chart.js revenue, booking, and loyalty analytics endpoints." },
