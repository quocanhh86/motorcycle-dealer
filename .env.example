# ==============================================================================
# Motorcycle Dealer & Loyalty Management Platform — Environment Template (T-301 / T-308)
# Copy to `.env` (gitignored) for Docker Compose or configure via `dotnet user-secrets`.
# NEVER commit real passwords, private keys, or production JWT signing secrets to Git.
# ==============================================================================

# 1. SQL Server 2022 Container Credentials (used by docker-compose.yml)
SQLSERVER_SA_PASSWORD=<Strong_Dev_Only_Placeholder>

# 2. ASP.NET Core 10 Connection String Override
# Native Windows LocalDB default:
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=MotorcycleDealerDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True
# Docker Compose SQL Server 2022 alternative:
# ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=MotorcycleDealerDb;User Id=sa;Password=<Strong_Dev_Only_Placeholder>;MultipleActiveResultSets=True;TrustServerCertificate=True;Encrypt=False

# 3. JWT Bearer & Rotating Refresh Token Settings (matches JwtOptions; >= 32-byte key required)
Jwt__Issuer=MotorcycleDealer.WebApi
Jwt__Audience=MotorcycleDealer.Spa
Jwt__SigningKey=<Replace_With_Min_32_Byte_Secret_Via_UserSecrets>
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# 4. Explicit SPA Origins for CORS & SignalR WebSockets (.AllowCredentials())
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=http://127.0.0.1:4200

# 5. Hosted VIN Maintenance Reminder Worker Options (matches VinMaintenanceReminderOptions)
MaintenanceReminderWorker__Enabled=true
MaintenanceReminderWorker__SweepIntervalSeconds=3600
